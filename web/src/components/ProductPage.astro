---
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.svelte';
import MembersOnly from './MembersOnly.astro';
import ProductStock from './ProductStock.svelte';
import { euros } from '../lib/format';
import { icon, iconBadge } from '../lib/icons';
import { WINE_TYPE_LABELS, drinkWindow, productSubtitle } from '../lib/products';
import type { ProductDetail, ProductKind } from '../lib/types';

/** A product (/produits/:slug) or a wine (/cave/:slug); `product` is null when the section is private. */
interface Props {
  kind: ProductKind;
  product: ProductDetail | null;
}
const { kind, product } = Astro.props;
const wine = kind === 'wine';
const base = wine ? '/cave' : '/produits';
const cover = product?.cover ?? null;
const coverPhoto = product?.photos.find((p) => p.id === cover?.id);
const gallery = product?.photos.filter((p) => p.id !== cover?.id) ?? [];
const facts = product
  ? ([
      ['Type', wine && product.wine_type ? WINE_TYPE_LABELS[product.wine_type] : ''],
      ['Millésime', product.vintage ?? ''],
      ['Appellation', product.appellation],
      ['Région', [product.region, product.country].filter(Boolean).join(', ')],
      ['Cépages', product.grape],
      ['Degré', product.abv ? `${String(product.abv).replace('.', ',')} %` : ''],
      ['À boire', drinkWindow(product)],
      ['Où l’acheter', product.store],
      ['Prix', euros(product.price_cents)],
    ].filter(([, v]) => v !== '') as [string, string | number][])
  : [];
---

<Base mode={wine ? 'cellar' : 'products'} title={product?.name ?? (wine ? 'Vin' : 'Produit')} description={product?.description || undefined} image={cover?.lg}>
  {
    !product ? (
      <MembersOnly label={wine ? 'Ce vin' : 'Ce produit'} />
    ) : (
      <article>
        <div class="top-links">
          <a class="back" href={base}>
            ← {wine ? 'Toute la cave' : 'Tous les produits'}
          </a>
          <a class="edit-link member-only" href={`/admin#/${wine ? 'cave' : 'produits'}/${product.id}`} data-astro-prefetch="false">
            <Fragment set:html={icon('pencil', 14)} />
            Modifier
          </a>
        </div>

        <div class="layout">
          <figure class="photo">
            {cover ? (
              <img src={cover.lg} srcset={`${cover.sm} 480w, ${cover.lg} 1600w`} sizes="(max-width: 760px) 100vw, 420px" alt="" fetchpriority="high" />
            ) : (
              <span class="placeholder" set:html={iconBadge(product.category?.icon ?? (wine ? 'wine' : 'package'), 96)} />
            )}
            {coverPhoto?.author && (
              <figcaption class="inline-icon">
                <Fragment set:html={icon('camera', 12)} />
                {coverPhoto.author}
              </figcaption>
            )}
          </figure>

          <div class="info">
            {product.category && (
              <p class="category inline-icon">
                <Fragment set:html={iconBadge(product.category.icon, 24)} />
                {product.category.name}
              </p>
            )}
            <h1>{product.name}</h1>
            {productSubtitle(product) && <p class="subtitle">{productSubtitle(product)}</p>}
            {product.description && <p class="description">{product.description}</p>}

            <ProductStock client:load id={product.id} name={product.name} />

            {facts.length > 0 && (
              <dl class="facts">
                {facts.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {product.tags.length > 0 && (
              <div class="tags">
                {product.tags.map((t) => (
                  <a class="tag" href={`${base}?tag=${encodeURIComponent(t)}`}>
                    #{t}
                  </a>
                ))}
              </div>
            )}

            {product.recipes.length > 0 && (
              <section class="recipes">
                <h2>{wine ? 'Accords mets-vins' : 'Utilisé dans'}</h2>
                <ul>
                  {product.recipes.map((r) => (
                    <li>
                      <a href={`/recettes/${r.slug}`}>{r.title}</a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>

        {gallery.length > 0 && (
          <section>
            <h2>Photos</h2>
            <Gallery client:visible photos={gallery} />
          </section>
        )}
      </article>
    )
  }
</Base>

<style>
  article {
    max-width: 1000px;
    margin: 0 auto;
    padding: calc(var(--header-h) + env(safe-area-inset-top) + 16px) 16px 64px;
  }
  .top-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }
  .back {
    display: inline-block;
    /* 44px tall tap zone; the negative margin keeps the layout unchanged. */
    padding: 12px 0;
    margin: -12px 0;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 420px) 1fr;
    gap: 40px;
    align-items: start;
  }
  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--surface-2);
  }
  figcaption {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 0.72rem;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .category {
    margin: 0;
    color: var(--accent);
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
  }
  .subtitle {
    margin: -6px 0 0;
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .description {
    margin: 0;
    font-size: 1.05rem;
    white-space: pre-line;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px 20px;
    margin: 0;
  }
  .facts dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .facts dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .recipes h2,
  section h2 {
    margin: 8px 0;
    font-size: 1.3rem;
  }
  .recipes ul {
    margin: 0;
    padding-left: 18px;
  }
  .recipes a {
    color: var(--accent);
    font-weight: 600;
  }
  section {
    margin-top: 40px;
  }
  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .photo {
      max-height: 60vh;
    }
  }
</style>
