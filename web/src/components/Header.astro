---
import { icon } from '../lib/icons';
import type { Section } from '../lib/types';

export type Mode = Section | 'admin';

interface Props {
  mode: Mode;
  locked?: Section[];
  hidden?: Section[];
}
const { mode, locked = [], hidden = [] } = Astro.props;
const placeholders: Partial<Record<Mode, string>> = {
  map: 'Chercher une adresse…',
  products: 'Chercher un produit…',
  cellar: 'Chercher un vin…',
};
const placeholder = placeholders[mode] ?? 'Chercher une recette…';
const links = (
  [
    { mode: 'map', href: '/', label: 'Carte', icon: 'map' },
    { mode: 'recipes', href: '/recettes', label: 'Recettes', icon: 'chef-hat' },
    { mode: 'planning', href: '/planning', label: 'Planning', icon: 'calendar' },
    { mode: 'products', href: '/produits', label: 'Produits', icon: 'shopping-basket' },
    { mode: 'cellar', href: '/cave', label: 'Cave', icon: 'wine' },
  ] as const
).filter((l) => !hidden.includes(l.mode));
const activeIndex = Math.max(0, links.findIndex((l) => l.mode === mode));
// Visitors never see private sections: the pill is positioned among the tabs they can see.
const publicLinks = links.filter((l) => !locked.includes(l.mode));
const publicIndex = publicLinks.findIndex((l) => l.mode === mode);
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<!-- No bar: each control floats on its own over the map or the page. -->
<header class:list={['site-header', { admin: mode === 'admin' }]}>
  <div class="left">
    {
      mode !== 'admin' && (
        <label class="search glass">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="visually-hidden">{placeholder}</span>
          <input id="site-search" type="search" placeholder={placeholder} value={initialQuery} autocomplete="off" enterkeyhint="search" aria-keyshortcuts="Control+K Meta+K /" />
          <kbd class="shortcut" hidden>Ctrl K</kbd>
        </label>
      )
    }
  </div>

  <!-- Desktop and tablets: centred toggle. Phones use the bottom tab bar below instead. -->
  <nav
    class:list={['toggle glass', { wide: links.length > 2, many: links.length > 3 }]}
    aria-label="Mode d'affichage"
    style={`--n-all: ${links.length}; --i-all: ${activeIndex}; --n-public: ${Math.max(1, publicLinks.length)}; --i-public: ${Math.max(0, publicIndex)}`}
    data-public-active={publicIndex >= 0 ? undefined : 'none'}
  >
    <div class="track">
      {
        links.map((l) => (
          <a href={l.href} class:list={{ active: mode === l.mode, private: locked.includes(l.mode) }} aria-current={mode === l.mode ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <span class="pill" hidden={mode === 'admin'}></span>
    </div>
  </nav>

  <div class="right">
    <!-- Connection status: filled in by the script below once membership is known. -->
    <a class="account glass" href="/admin" title="Non connecté — se connecter" aria-label="Non connecté, se connecter" data-astro-prefetch="false">
      <span class="anon"><Fragment set:html={icon('user', 18)} /></span>
      <span class="initial" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
    </a>
    <a class="brand glass" href="/admin" title="Espace membres" data-astro-prefetch="false">Bouffe Center</a>
  </div>
</header>

{
  mode !== 'admin' && (
    <nav class="tabbar" aria-label="Sections">
      {links.map((l) => (
        <a href={l.href} class:list={{ active: mode === l.mode, private: locked.includes(l.mode) }} aria-current={mode === l.mode ? 'page' : undefined} data-astro-prefetch="viewport">
          <span class="tab-pill">
            <Fragment set:html={icon(l.icon, 22)} />
            <span class="tab-label">{l.label}</span>
          </span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: calc(var(--header-h) + env(safe-area-inset-top));
    padding: env(safe-area-inset-top) max(16px, env(safe-area-inset-right)) 0 max(16px, env(safe-area-inset-left));
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 10px;
    /* Let clicks and map drags pass through the empty space between controls. */
    pointer-events: none;
  }
  /* Back-office: the header scrolls away with the page instead of floating over forms and tabs. */
  .site-header.admin {
    position: absolute;
  }
  .site-header > * > *,
  .toggle {
    pointer-events: auto;
  }
  .left {
    min-width: 0;
    position: relative;
  }
  .right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .account {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    color: var(--muted);
    text-decoration: none;
  }
  .account .initial {
    display: none;
  }
  .account .dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--surface);
    background: #b9b0a6;
  }
  /* Connected: initial on a red disc + green status dot. */
  :global(html.member) .account {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  :global(html.member) .account .anon {
    display: none;
  }
  :global(html.member) .account .initial {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1;
  }
  :global(html.member) .account .dot {
    background: var(--good);
  }

  .glass {
    background: var(--glass);
    backdrop-filter: saturate(1.8) blur(16px);
    -webkit-backdrop-filter: saturate(1.8) blur(16px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 4px 20px rgb(31 27 22 / 0.12);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 320px;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--muted);
    transition: box-shadow 0.15s;
  }
  .search:focus-within {
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent),
      0 4px 20px rgb(31 27 22 / 0.12);
    border-color: var(--accent);
  }
  .search svg {
    flex: none;
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
  }
  .search input::placeholder {
    color: var(--muted);
  }
  .shortcut {
    flex: none;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--muted);
    font: 600 0.72rem var(--font);
    letter-spacing: 0.02em;
  }
  .search:focus-within .shortcut {
    display: none;
  }
  @media (hover: none), (max-width: 640px) {
    .shortcut {
      display: none;
    }
  }

  .toggle {
    min-width: 0;
    padding: 4px;
    border-radius: 999px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .toggle::-webkit-scrollbar {
    display: none;
  }
  .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    width: max-content;
    min-width: 100%;
  }
  .toggle a {
    position: relative;
    z-index: 1;
    padding: 7px 18px;
    border-radius: 999px;
    text-align: center;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .pill {
    view-transition-name: toggle-pill;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(100% / var(--n));
    border-radius: 999px;
    background: var(--accent);
    transform: translateX(calc(var(--i) * 100%));
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .toggle a.active {
    color: var(--accent-ink);
  }
  /*
    Private sections are left out of the toggle for visitors. Member detection runs before the first paint
    (html.member), so the same cached HTML serves both and members never see the tabs flicker in.
  */
  .toggle {
    --n: var(--n-public);
    --i: var(--i-public);
  }
  .toggle a.private,
  .tabbar a.private {
    display: none;
  }
  /* A visitor on a private page (members-only screen): no tab is highlighted. */
  .toggle[data-public-active='none'] .pill {
    visibility: hidden;
  }
  :global(html.member) .toggle {
    --n: var(--n-all);
    --i: var(--i-all);
  }
  :global(html.member) .toggle a.private,
  :global(html.member) .tabbar a.private {
    display: flex;
  }
  :global(html.member) .toggle[data-public-active='none'] .pill {
    visibility: visible;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 800;
    font-style: normal;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /* Phones: sections live in a tab bar at the bottom, within thumb reach. */
  .tabbar {
    display: none;
  }
  @media (max-width: 640px) {
    .site-header {
      gap: 8px;
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .toggle {
      display: none;
    }
    /* Floating "liquid glass" capsule: the page shows through, heavily blurred so it never competes with the labels. */
    .tabbar {
      position: fixed;
      z-index: 50;
      left: max(16px, env(safe-area-inset-left));
      right: max(16px, env(safe-area-inset-right));
      bottom: max(12px, env(safe-area-inset-bottom));
      display: flex;
      height: 58px;
      padding: 7px;
      border-radius: 29px;
      background: color-mix(in srgb, var(--surface) 60%, transparent);
      backdrop-filter: blur(24px) saturate(1.9);
      -webkit-backdrop-filter: blur(24px) saturate(1.9);
      border: 1px solid rgb(255 255 255 / 0.6);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.7),
        inset 0 -1px 0 rgb(31 27 22 / 0.04),
        0 10px 30px rgb(31 27 22 / 0.18);
      view-transition-name: tabbar;
    }
    @media (prefers-color-scheme: dark) {
      .tabbar {
        background: color-mix(in srgb, var(--surface) 70%, transparent);
        border-color: rgb(255 255 255 / 0.12);
        box-shadow:
          inset 0 1px 0 rgb(255 255 255 / 0.1),
          0 10px 30px rgb(0 0 0 / 0.5);
      }
    }
    /* Icons only; the active tab's red pill widens to show its name (the others keep theirs for screen readers). */
    /* Equal slots, so 2 or 5 visible tabs stay balanced; the active one never gets narrower than its pill. */
    .tabbar a {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      text-decoration: none;
    }
    .tab-pill {
      display: flex;
      align-items: center;
      gap: 7px;
      height: 44px;
      padding: 0 13px;
      border-radius: 999px;
      transition:
        background-color 0.2s,
        color 0.2s;
    }
    .tab-pill :global(svg) {
      flex: none;
    }
    .tab-label {
      white-space: nowrap;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.92rem;
      line-height: 1;
    }
    .tabbar a:not(.active) .tab-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    /* Active tab: white icon and name on the red pill (house style). */
    .tabbar a.active {
      min-width: max-content;
    }
    .tabbar a.active .tab-pill {
      padding: 0 16px 0 14px;
      background: var(--accent);
      color: var(--accent-ink);
      box-shadow: 0 4px 12px rgb(209 56 47 / 0.35);
      /* Morphs (moves and widens) from the old tab to the new one during the page transition. */
      view-transition-name: tab-active;
    }
    .search {
      width: 44px;
      padding: 0 12px;
      cursor: pointer;
    }
    .search input {
      width: 0;
    }
    /* Expand the search field over the header while typing. */
    .search:focus-within {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      width: calc(100vw - 32px - env(safe-area-inset-left) - env(safe-area-inset-right));
      max-width: none;
      z-index: 2;
      cursor: text;
    }
  }
</style>


<script>
  // Show who is connected next to the logo (members only call /api/auth/me; visitors make no request).
  const account = document.querySelector<HTMLAnchorElement>('.account');
  const showAccount = async () => {
    if (!account || !document.documentElement.classList.contains('member')) return;
    try {
      const { user } = await (await fetch('/api/auth/me')).json();
      if (!user) return document.documentElement.classList.remove('member');
      account.querySelector('.initial')!.textContent = user.pseudo.slice(0, 1).toUpperCase();
      account.title = `Connecté : ${user.pseudo} — espace membres`;
      account.setAttribute('aria-label', `Connecté en tant que ${user.pseudo}, espace membres`);
    } catch {}
  };
  showAccount();
  addEventListener('bc:member', showAccount);

  // Keyboard shortcut to grab the search field: ⌘K (Mac), Ctrl+K (PC) or "/".
  const search = document.getElementById('site-search') as HTMLInputElement | null;
  if (search) {
    const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    const hint = document.querySelector<HTMLElement>('.search .shortcut');
    if (hint) {
      hint.textContent = mac ? '⌘K' : 'Ctrl K';
      hint.hidden = false;
    }
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const typing = target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        search.focus();
        search.select();
      } else if (e.key === '/' && !typing) {
        e.preventDefault();
        search.focus();
      } else if (e.key === 'Escape' && target === search) {
        search.blur();
      }
    });
    // The planning page has no search of its own: Enter searches the recipes.
    if (document.querySelector('.toggle a[aria-current="page"][href="/planning"]')) {
      search.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && search.value.trim()) location.href = `/recettes?q=${encodeURIComponent(search.value.trim())}`;
      });
    }
  }

  // Bottom tab bar: highlight the tapped tab right away, unless the browser animates the switch between pages
  // (cross-document view transitions), which slides the red pill to the new tab by itself.
  if (!('onpageswap' in window)) document.querySelectorAll<HTMLAnchorElement>('.tabbar a').forEach((link) => {
    link.addEventListener('click', () => {
      document.querySelector('.tabbar a.active')?.classList.remove('active');
      link.classList.add('active');
    });
  });

  // Slide the pill before navigating so the toggle feels instant.
  const toggle = document.querySelector<HTMLElement>('.toggle');
  // The index counts only the tabs on screen (visitors don't see private sections).
  document.querySelectorAll<HTMLAnchorElement>('.toggle a').forEach((link) => {
    link.addEventListener('click', () => {
      const visible = [...document.querySelectorAll<HTMLAnchorElement>('.toggle a')].filter((a) => a.offsetParent !== null);
      toggle?.style.setProperty('--i', String(visible.indexOf(link)));
      toggle?.removeAttribute('data-public-active');
    });
  });
  // A scrolling toggle (phones, many tabs) starts centred on the current tab.
  const current = document.querySelector<HTMLElement>('.toggle a[aria-current="page"]');
  if (toggle && current && toggle.scrollWidth > toggle.clientWidth) {
    toggle.scrollLeft = current.offsetLeft - (toggle.clientWidth - current.offsetWidth) / 2;
  }
</script>
