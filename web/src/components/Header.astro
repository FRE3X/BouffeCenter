---
import { icon } from '../lib/icons';
import type { Section } from '../lib/types';

export type Mode = Section | 'admin';

interface Props {
  mode: Mode;
  locked?: Section[];
  hidden?: Section[];
}
const { mode, locked = [], hidden = [] } = Astro.props;
const placeholders: Partial<Record<Mode, string>> = {
  map: 'Chercher une adresse…',
  products: 'Chercher un produit…',
  cellar: 'Chercher un vin…',
};
const placeholder = placeholders[mode] ?? 'Chercher une recette…';
const links = (
  [
    { mode: 'map', href: '/', label: 'Carte' },
    { mode: 'recipes', href: '/recettes', label: 'Recettes' },
    { mode: 'planning', href: '/planning', label: 'Planning' },
    { mode: 'products', href: '/produits', label: 'Produits' },
    { mode: 'cellar', href: '/cave', label: 'Cave' },
  ] as const
).filter((l) => !hidden.includes(l.mode));
const activeIndex = Math.max(0, links.findIndex((l) => l.mode === mode));
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<!-- No bar: each control floats on its own over the map or the page. -->
<header class="site-header">
  <div class="left">
    {
      mode !== 'admin' && (
        <label class="search glass">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="visually-hidden">{placeholder}</span>
          <input id="site-search" type="search" placeholder={placeholder} value={initialQuery} autocomplete="off" enterkeyhint="search" aria-keyshortcuts="Control+K Meta+K /" />
          <kbd class="shortcut" hidden>Ctrl K</kbd>
        </label>
      )
    }
  </div>

  <!-- With more than three tabs, the toggle scrolls sideways on phones (the track keeps the pill aligned). -->
  <nav
    class:list={['toggle glass', { wide: links.length > 2, many: links.length > 3 }]}
    aria-label="Mode d'affichage"
    style={`--n: ${links.length}; --i: ${activeIndex}`}
  >
    <div class="track">
      {
        links.map((l) => (
          <a href={l.href} class:list={{ active: mode === l.mode }} aria-current={mode === l.mode ? 'page' : undefined}>
            {l.label}
            {locked.includes(l.mode) && <span class="lock" title="Réservé aux membres"><Fragment set:html={icon('lock', 12, 2.5)} /><span class="visually-hidden"> (réservé aux membres)</span></span>}
          </a>
        ))
      }
      <span class="pill" hidden={mode === 'admin'}></span>
    </div>
  </nav>

  <div class="right">
    <!-- Connection status: filled in by the script below once membership is known. -->
    <a class="account glass" href="/admin" title="Non connecté — se connecter" aria-label="Non connecté, se connecter" data-astro-prefetch="false">
      <span class="anon"><Fragment set:html={icon('user', 18)} /></span>
      <span class="initial" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
    </a>
    <a class="brand glass" href="/admin" title="Espace membres" data-astro-prefetch="false">
      <span class="full">Bouffe Center</span>
      <span class="short" aria-hidden="true">BC</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: calc(var(--header-h) + env(safe-area-inset-top));
    padding: env(safe-area-inset-top) max(14px, env(safe-area-inset-right)) 0 max(14px, env(safe-area-inset-left));
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 10px;
    /* Let clicks and map drags pass through the empty space between controls. */
    pointer-events: none;
  }
  .site-header > * > *,
  .toggle {
    pointer-events: auto;
  }
  .left {
    min-width: 0;
    position: relative;
  }
  .right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .account {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    color: var(--muted);
    text-decoration: none;
  }
  .account .initial {
    display: none;
  }
  .account .dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--surface);
    background: #b9b0a6;
  }
  /* Connected: initial on a red disc + green status dot. */
  :global(html.member) .account {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  :global(html.member) .account .anon {
    display: none;
  }
  :global(html.member) .account .initial {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
  }
  :global(html.member) .account .dot {
    background: var(--good);
  }

  .glass {
    background: var(--glass);
    backdrop-filter: saturate(1.8) blur(16px);
    -webkit-backdrop-filter: saturate(1.8) blur(16px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 4px 20px rgb(31 27 22 / 0.12);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 320px;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--muted);
    transition: box-shadow 0.15s;
  }
  .search:focus-within {
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent),
      0 4px 20px rgb(31 27 22 / 0.12);
    border-color: var(--accent);
  }
  .search svg {
    flex: none;
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
  }
  .search input::placeholder {
    color: var(--muted);
  }
  .shortcut {
    flex: none;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--muted);
    font: 600 0.72rem var(--font);
    letter-spacing: 0.02em;
  }
  .search:focus-within .shortcut {
    display: none;
  }
  @media (hover: none), (max-width: 640px) {
    .shortcut {
      display: none;
    }
  }

  .toggle {
    min-width: 0;
    padding: 4px;
    border-radius: 999px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .toggle::-webkit-scrollbar {
    display: none;
  }
  .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    width: max-content;
    min-width: 100%;
  }
  .toggle a {
    position: relative;
    z-index: 1;
    padding: 7px 18px;
    border-radius: 999px;
    text-align: center;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .pill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(100% / var(--n));
    border-radius: 999px;
    background: var(--accent);
    transform: translateX(calc(var(--i) * 100%));
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .toggle a.active {
    color: var(--accent-ink);
  }
  /* Private section: a small lock for visitors (members never see it). */
  .lock {
    display: inline-block;
    margin-left: 4px;
    vertical-align: 1px;
    opacity: 0.8;
  }
  .lock :global(svg) {
    display: inline-block;
  }
  :global(html.member) .lock {
    display: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 800;
    font-style: normal;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand .short {
    display: none;
  }

  @media (max-width: 640px) {
    /* The side buttons keep their size; the toggle takes the rest and scrolls if needed. */
    .site-header {
      gap: 8px;
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .toggle {
      justify-self: center;
      max-width: 100%;
    }
    .toggle a {
      padding: 7px 13px;
      font-size: 0.95rem;
    }
    .toggle.wide a {
      padding: 7px 10px;
      font-size: 0.88rem;
    }
    .search {
      width: 44px;
      padding: 0 12px;
      cursor: pointer;
    }
    .search input {
      width: 0;
    }
    /* Expand the search field over the header while typing. */
    .search:focus-within {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      width: calc(100vw - 28px - env(safe-area-inset-left) - env(safe-area-inset-right));
      max-width: none;
      z-index: 2;
      cursor: text;
    }
  }
</style>

<style>
  /* Three tabs on a small phone: tighter tabs, and the round account button alone links to the back-office. */
  @media (max-width: 400px) {
    .toggle.wide a {
      padding: 6px 7px;
      font-size: 0.8rem;
    }
    .site-header:has(.toggle.wide) .brand {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .brand {
      width: 44px;
      padding: 0;
      justify-content: center;
      font-size: 1rem;
    }
    .brand .full {
      display: none;
    }
    .brand .short {
      display: inline;
    }
  }
</style>

<script>
  // Show who is connected next to the logo (members only call /api/auth/me; visitors make no request).
  const account = document.querySelector<HTMLAnchorElement>('.account');
  const showAccount = async () => {
    if (!account || !document.documentElement.classList.contains('member')) return;
    try {
      const { user } = await (await fetch('/api/auth/me')).json();
      if (!user) return document.documentElement.classList.remove('member');
      account.querySelector('.initial')!.textContent = user.pseudo.slice(0, 1).toUpperCase();
      account.title = `Connecté : ${user.pseudo} — espace membres`;
      account.setAttribute('aria-label', `Connecté en tant que ${user.pseudo}, espace membres`);
    } catch {}
  };
  showAccount();
  addEventListener('bc:member', showAccount);

  // Keyboard shortcut to grab the search field: ⌘K (Mac), Ctrl+K (PC) or "/".
  const search = document.getElementById('site-search') as HTMLInputElement | null;
  if (search) {
    const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    const hint = document.querySelector<HTMLElement>('.search .shortcut');
    if (hint) {
      hint.textContent = mac ? '⌘K' : 'Ctrl K';
      hint.hidden = false;
    }
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const typing = target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        search.focus();
        search.select();
      } else if (e.key === '/' && !typing) {
        e.preventDefault();
        search.focus();
      } else if (e.key === 'Escape' && target === search) {
        search.blur();
      }
    });
    // The planning page has no search of its own: Enter searches the recipes.
    if (document.querySelector('.toggle a[aria-current="page"][href="/planning"]')) {
      search.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && search.value.trim()) location.href = `/recettes?q=${encodeURIComponent(search.value.trim())}`;
      });
    }
  }

  // Slide the pill before navigating so the toggle feels instant.
  const toggle = document.querySelector<HTMLElement>('.toggle');
  document.querySelectorAll<HTMLAnchorElement>('.toggle a').forEach((link, i) => {
    link.addEventListener('click', () => toggle?.style.setProperty('--i', String(i)));
  });
  // A scrolling toggle (phones, many tabs) starts centred on the current tab.
  const current = document.querySelector<HTMLElement>('.toggle a[aria-current="page"]');
  if (toggle && current && toggle.scrollWidth > toggle.clientWidth) {
    toggle.scrollLeft = current.offsetLeft - (toggle.clientWidth - current.offsetWidth) / 2;
  }
</script>
