---
import Base from '../layouts/Base.astro';
import PlanningGrid from '../components/PlanningGrid.astro';
import MembersOnly from '../components/MembersOnly.astro';
import { publicCache, sectionAccess, serverApi } from '../lib/api';
import { icon } from '../lib/icons';
import { MEALS, weekRange } from '../lib/planning';
import type { PlanningWeek } from '../lib/types';

const requested = Astro.url.searchParams.get('semaine');
const week = requested && /^\d{4}-\d{2}-\d{2}$/.test(requested) ? requested : null;
const access = await sectionAccess(Astro, 'planning');
let locked = false;
const plan = await serverApi<PlanningWeek>(`/planning${week ? `?week=${week}` : ''}`, access).catch((e) => {
  if (access.locked(e)) locked = true;
  return null;
});
if (!plan && !locked) return Astro.rewrite('/404');

const sunday = plan?.days[6].date ?? '';
const isCurrent = plan ? plan.today >= plan.week && plan.today <= sunday : false;
publicCache(Astro, access.isPrivate, 'public, max-age=0, s-maxage=30, stale-while-revalidate=300');
---

<Base mode="planning" title="Menu de la semaine" description={plan ? `Notre menu de la semaine, ${weekRange(plan.week, sunday)}.` : undefined}>
  {!plan ? <MembersOnly label="Le planning des menus" /> : (
  <main>
    <div class="head">
      <div>
        <h1>Menu de la semaine</h1>
        <p class="range">{weekRange(plan.week, sunday)}</p>
      </div>
      <nav class="weeks" aria-label="Changer de semaine">
        <a class="nav-btn" href={`/planning?semaine=${plan.prev}`} title="Semaine précédente" aria-label="Semaine précédente">
          <Fragment set:html={icon('chevron-left', 20)} />
        </a>
        {!isCurrent && <a class="now" href="/planning">Cette semaine</a>}
        <a class="nav-btn" href={`/planning?semaine=${plan.next}`} title="Semaine suivante" aria-label="Semaine suivante">
          <Fragment set:html={icon('chevron-right', 20)} />
        </a>
        <a class="edit-link member-only" href={`/admin#/planning/${plan.week}`} data-astro-prefetch="false">
          <Fragment set:html={icon('pencil', 15)} />Modifier
        </a>
      </nav>
    </div>

    <div class="chip-row filters" role="group" aria-label="Repas affichés">
      {MEALS.map((m) => <button type="button" class="chip" data-meal={m.key} aria-pressed="true">{m.label}</button>)}
    </div>

    <PlanningGrid plan={plan} />

    <!-- Members only: out-of-stock products linked to this week's recipes, filled in by the script below. -->
    <section class="shopping" data-week={plan.week} hidden>
      <h2><Fragment set:html={icon('shopping-cart', 22)} />À racheter cette semaine</h2>
      <ul></ul>
    </section>

    <!-- Meal filter: remembered per browser, applied before the grid paints. -->
    <script is:inline>
      (function () {
        var KEY = 'bc_planning_hidden';
        var week = document.getElementById('planning-week');
        var chips = document.querySelectorAll('.filters .chip');
        var hidden = [];
        try {
          hidden = JSON.parse(localStorage.getItem(KEY) || '[]');
        } catch (e) {}
        function apply() {
          chips.forEach(function (chip) {
            var off = hidden.indexOf(chip.dataset.meal) !== -1;
            chip.setAttribute('aria-pressed', String(!off));
            week.classList.toggle('hide-' + chip.dataset.meal, off);
          });
        }
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            var meal = chip.dataset.meal;
            var i = hidden.indexOf(meal);
            if (i !== -1) hidden.splice(i, 1);
            else if (hidden.length < chips.length - 1) hidden.push(meal); // always keep one meal visible
            try {
              localStorage.setItem(KEY, JSON.stringify(hidden));
            } catch (e) {}
            apply();
          });
        });
        apply();
      })();
    </script>
  </main>
  )}
</Base>

<style>
  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: calc(var(--header-h) + env(safe-area-inset-top) + 24px) max(16px, env(safe-area-inset-right)) 48px
      max(16px, env(safe-area-inset-left));
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 16px;
    margin-bottom: 14px;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  .range {
    margin: 2px 0 0;
    color: var(--muted);
  }
  .weeks {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .nav-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .now {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .filters {
    margin-bottom: 16px;
  }
  .shopping {
    max-width: 640px;
    margin-top: 32px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .shopping h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    font-size: 1.35rem;
  }
  .shopping h2 :global(svg) {
    color: var(--accent);
  }
  .shopping ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shopping :global(li) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
  }
  .shopping :global(li:last-child) {
    border: 0;
  }
  .shopping :global(.what) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .shopping :global(.what a) {
    font-weight: 600;
    text-decoration: none;
  }
  .shopping :global(.what small) {
    color: var(--muted);
  }
  .shopping :global(button) {
    flex: none;
    padding: 6px 12px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: none;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }
</style>

<script>
  import { onMember } from '../lib/member';
  import { productHref } from '../lib/products';
  import type { ProductKind } from '../lib/types';

  type Item = { id: number; slug: string; kind: ProductKind; name: string; brand: string; recipes: { title: string }[] };

  const box = document.querySelector<HTMLElement>('.shopping[data-week]');
  if (box) {
    onMember(async () => {
      const res = await fetch(`/api/planning/shopping?week=${box.dataset.week}`);
      if (!res.ok) return;
      const { items } = (await res.json()) as { items: Item[] };
      const list = box.querySelector('ul')!;
      for (const item of items) {
        const li = document.createElement('li');
        const what = document.createElement('span');
        what.className = 'what';
        const link = document.createElement('a');
        link.href = productHref(item);
        link.textContent = item.brand ? `${item.name} · ${item.brand}` : item.name;
        const used = document.createElement('small');
        used.textContent = `Pour : ${item.recipes.map((r) => r.title).join(', ')}`;
        what.append(link, used);
        // Bought it: back in stock, off the list.
        const bought = document.createElement('button');
        bought.type = 'button';
        bought.textContent = 'Acheté';
        bought.addEventListener('click', async () => {
          bought.disabled = true;
          const r = await fetch(`/api/products/${item.id}/stock`, {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ delta: 1 }),
          });
          if (!r.ok) return (bought.disabled = false);
          li.remove();
          if (!list.children.length) box.hidden = true;
        });
        li.append(what, bought);
        list.append(li);
      }
      box.hidden = !items.length;
    });
  }
</script>
