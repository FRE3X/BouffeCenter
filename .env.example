# Public URL of the site (used in invitation links; https enables secure cookies)
PUBLIC_URL=http://localhost:4321

# Admin account created on first start (only while the database has no user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_PSEUDO=admin

# Optional
# PORT=3000
# DATA_DIR=./data              # SQLite database + images (persistent volume in production)
# MAX_UPLOAD_MB=15
# MAX_RESTORE_MB=4096          # maximum size of a backup to restore (Admin > Paramètres)
# CORS_ORIGINS=https://other-front.example.com   # origins allowed to call the API with cookies
# SEED_ON_EMPTY=false          # start with an empty database instead of the default content
